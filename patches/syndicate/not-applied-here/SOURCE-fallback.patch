+
+const PROVIDER_LIMIT_ERROR_PATTERN =
+  /\b429\b|too many requests|rate.?limit|insufficient[_\s-]?(quota|balance|credits?|tokens?)|quota|token\s*limit|limit\s*(reached|exhausted|exceeded)|no available (models?|capacity)/i;
+
+/**
+ * Extracts the text of `type: "error"` events from an OpenCode JSONL stdout.
+ */
+export function extractOpenCodeErrorEvents(stdout: string): string[] {
+  const errors: string[] = [];
+  for (const rawLine of stdout.split(/\r?\n/)) {
+    const line = rawLine.trim();
+    if (!line) continue;
+    const event = parseJson(line);
+    if (!event || asString(event.type, "") !== "error") continue;
+    const text = errorText(event.error ?? event.message).trim();
+    if (text) errors.push(text);
+  }
+  return errors;
+}
+
+/**
+ * Detects provider-side token/quota exhaustion in an OpenCode run failure
+ * (e.g. MiniMax coding-plan limits: HTTP 429, "quota exceeded", "insufficient
+ * balance"). These are transient account-level conditions where retrying the
+ * same model is futile but a fallback model on another provider can succeed.
+ *
+ * The detector only looks at error channels (stderr + `type: "error"` events),
+ * never the agent's text output, so task content mentioning limits cannot
+ * trigger a false positive.
+ */
+export function isOpenCodeProviderLimitError(
+  stdout: string,
+  stderr: string,
+  parsedErrorMessage?: string | null,
+): boolean {
+  const haystack = [
+    ...extractOpenCodeErrorEvents(stdout),
+    stderr,
+    parsedErrorMessage ?? "",
+  ]
+    .join("\n")
+    .trim();
+
+  return PROVIDER_LIMIT_ERROR_PATTERN.test(haystack);
+}
